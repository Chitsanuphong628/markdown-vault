# Public browser configuration
NEXT_PUBLIC_APP_URL=https://your-nota-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key

# Server-only Vercel secrets. Generate JWT_SECRET and AUTH_TOKEN_PEPPER with a
# cryptographically secure password generator; never reuse either with MCP.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
JWT_SECRET=replace_with_a_32_byte_or_longer_random_secret
AUTH_TOKEN_PEPPER=replace_with_a_different_32_byte_or_longer_random_secret
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=Nota <no-reply@your-nota-domain.example>
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Apply the MCP credential migration before setting this to true.
ENABLE_MCP=false
# Optional external OAuth authorization server. All four values are required;
# its JWT sub must equal a verified Nota User.id, scope include mcp, and aud be
# the exact public https://your-nota-domain.example/api/mcp URL.
# MCP_OAUTH_ISSUER=https://auth.example.com
# MCP_OAUTH_AUTHORIZATION_ENDPOINT=https://auth.example.com/authorize
# MCP_OAUTH_TOKEN_ENDPOINT=https://auth.example.com/token
# MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
